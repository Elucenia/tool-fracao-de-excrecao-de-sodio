{
  "tool": {
    "id": "fracao-de-excrecao-de-sodio",
    "title": "Fração de excreção de sódio (FENa)",
    "short": "Pré-renal ou necrose tubular aguda na LRA oligúrica",
    "desc": "Calcule a fração de excreção de sódio (FENa) para diferenciar azotemia pré-renal de necrose tubular aguda na lesão renal aguda oligúrica.",
    "lead": "Mede a porcentagem do sódio filtrado que é excretada na urina. Na lesão renal aguda oligúrica, ajuda a separar a azotemia pré-renal (túbulo íntegro, que retém sódio) da necrose tubular aguda.",
    "kind": "Calculadora",
    "spec": [
      "nefrologia",
      "clinica-medica",
      "medicina-intensiva",
      "medicina-de-emergencia"
    ],
    "fields": [
      [
        "una",
        "Sódio urinário",
        "num",
        {
          "min": 1,
          "max": 300,
          "unit": "mEq/L",
          "ph": "20"
        }
      ],
      [
        "pna",
        "Sódio sérico",
        "num",
        {
          "min": 100,
          "max": 180,
          "unit": "mEq/L",
          "ph": "140"
        }
      ],
      [
        "ucr",
        "Creatinina urinária",
        "num",
        {
          "min": 1,
          "max": 500,
          "step": 0.1,
          "unit": "mg/dL",
          "ph": "80"
        }
      ],
      [
        "pcr",
        "Creatinina sérica",
        "num",
        {
          "min": 0.2,
          "max": 20,
          "step": 0.01,
          "unit": "mg/dL",
          "ph": "2,5"
        }
      ],
      [
        "diuretico",
        "Usou diurético nas últimas 24 h?",
        "radio",
        {
          "opts": {
            "0": "Não",
            "1": "Sim"
          }
        }
      ]
    ],
    "formula": "<p>FENa (%) = (Na urinário × creatinina sérica) ÷ (Na sérico × creatinina urinária) × 100.</p><p>Use amostras de urina e sangue colhidas no mesmo momento, antes de diurético ou de volume, sempre que possível.</p>",
    "sources": [
